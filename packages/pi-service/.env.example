# Pi Service Environment Variables
# Copy to .env and fill in your values

PORT=3000
API_KEY=  # Generate with: openssl rand -hex 32

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# n8n Webhook
N8N_WEBHOOK_URL=

# Paths
CLAUDE_PATH=~/.local/bin/claude
STATE_FILE=~/.claude-commander/state.json

# Settings
MAX_SESSIONS=5
POLL_INTERVAL_MS=1500
ALLOWED_CALLER_NUMBER=

# =============================================================================
# Claude Voice Commander - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env files with real credentials!
# =============================================================================

# -----------------------------------------------------------------------------
# Pi Service Configuration
# -----------------------------------------------------------------------------
# Port for the Pi service to listen on
PORT=3000

# API key for authenticating requests from n8n (generate with: openssl rand -hex 32)
API_KEY=

# Path to Claude CLI binary
CLAUDE_PATH=~/.local/bin/claude

# Local state file for persistence across reboots
STATE_FILE=~/.claude-commander/state.json

# Maximum concurrent tmux sessions
MAX_SESSIONS=5

# Output monitor polling interval (milliseconds)
POLL_INTERVAL_MS=1500

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
# Your Supabase project URL (https://xxx.supabase.co)
SUPABASE_URL=

# Supabase service role key (NOT the anon key - needs full access)
SUPABASE_SERVICE_KEY=

# -----------------------------------------------------------------------------
# n8n Integration
# -----------------------------------------------------------------------------
# Webhook URL for sending events to n8n
# Example: https://your-n8n.app.n8n.cloud/webhook/pi-events
N8N_WEBHOOK_URL=

# -----------------------------------------------------------------------------
# User Configuration
# -----------------------------------------------------------------------------
# Your phone number in E.164 format (only this number can call in)
ALLOWED_CALLER_NUMBER=+1XXXXXXXXXX

# Email for notifications
USER_EMAIL=

# Slack channel ID for fallback notifications
SLACK_CHANNEL_ID=

# -----------------------------------------------------------------------------
# Telnyx (configured in n8n, listed here for reference)
# -----------------------------------------------------------------------------
# TELNYX_API_KEY=KEY_xxx
# TELNYX_PHONE_NUMBER=+1xxx
# TELNYX_CONNECTION_ID=xxx

# -----------------------------------------------------------------------------
# ElevenLabs (configured in n8n, listed here for reference)
# -----------------------------------------------------------------------------
# ELEVENLABS_API_KEY=xxx
# ELEVENLABS_VOICE_ID=3sfGn775ryaDXhFWHwBg

# -----------------------------------------------------------------------------
# DND (Do Not Disturb) Settings
# -----------------------------------------------------------------------------
# Enable DND by default (true/false)
DND_ENABLED=false

# DND schedule (24-hour format, e.g., "23:00-07:00")
DND_SCHEDULE=

# -----------------------------------------------------------------------------
# Dashboard Configuration (for packages/dashboard/.env.local)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=xxx
# NEXT_PUBLIC_PI_SERVICE_URL=https://claudepi.tailnet.ts.net

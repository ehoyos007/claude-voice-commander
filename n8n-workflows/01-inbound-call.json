        "specifyBody": "json",
        "jsonBody": "={\n  \"name\": {{ JSON.stringify($('Parse Intent').item.json.sessionName || 'new-project') }},\n  \"initialPrompt\": {{ JSON.stringify($('Parse Intent').item.json.message || '') }}\n}",
        "options": { "response": { "response": { "neverError": true } } }
      },
      "id": "pi-create-session",

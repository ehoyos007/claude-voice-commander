        "jsCode": "// Build goodbye TTS text for end_call intent\nconst intentData = $('Parse Intent').first().json;\nconst state = intentData.state;\n\nconst hasActiveSessions = Object.keys(state.sessionContext).length > 0;\nlet goodbyeText;\nif (hasActiveSessions) {\n  goodbyeText = \"Alright, Claude's on it. I'll call if anything else comes up!\";\n} else {\n  goodbyeText = \"Talk soon!\";\n}\n\nreturn {\n  json: {\n    responseText: goodbyeText,\n    callControlId: intentData.callControlId,\n    state,\n    clientState: Buffer.from(JSON.stringify(state)).toString('base64')\n  }\n};"

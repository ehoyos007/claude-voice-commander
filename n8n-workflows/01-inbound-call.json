    {
      "parameters": {
        "jsCode": "// Build response text based on intent and Pi API response\nconst intentData = $('Parse Intent').first().json;\nconst piResponse = $input.first().json;\nconst intent = intentData.intent;\n\nlet responseText = '';\nlet updatedSessionContext = { ...intentData.state.sessionContext };\n\nswitch (intent) {\n  case 'create_session': {\n    if (piResponse.session) {\n      updatedSessionContext = { sessionId: piResponse.session.id, sessionName: piResponse.session.name };\n      if (intentData.message) {\n        responseText = `${piResponse.session.name} is running and I've sent over your instructions. Claude's on it.`;\n      } else {\n        responseText = `Got it, ${piResponse.session.name} is up and running. What should Claude work on first?`;\n      }\n    } else {\n      responseText = piResponse.error?.includes('exists')\n        ? `There's already a session called ${intentData.sessionName}. Want me to use that one, or pick a different name?`\n        : `Sorry, I couldn't create that session. ${piResponse.error || 'Something went wrong.'}`;\n    }\n    break;\n  }\n  case 'list_sessions': {\n    const sessions = piResponse.sessions || [];\n    if (sessions.length === 0) {\n      responseText = \"No sessions running right now. Want to start one?\";\n    } else {\n      const statusMap = { running: 'actively working', idle: 'idle', error: 'has errors', waiting_input: 'waiting for input', preserved: 'preserved from before the reboot' };\n      const descriptions = sessions.map(s => `${s.name} is ${statusMap[s.status] || s.status}`).join('. ');\n      responseText = `You've got ${sessions.length} session${sessions.length > 1 ? 's' : ''} running. ${descriptions}.`;\n      // If only one session, auto-set context\n      if (sessions.length === 1) {\n        updatedSessionContext = { sessionId: sessions[0].id, sessionName: sessions[0].name };\n      }\n    }\n    break;\n  }\n  case 'check_status': {\n    if (piResponse.session) {\n      const s = piResponse.session;\n      responseText = `${s.name} is ${s.status}. ${s.lastOutputPreview ? 'Latest output: ' + s.lastOutputPreview.slice(0, 100) : ''}`;\n    } else {\n      responseText = \"I couldn't find that session. Want me to list what's running?\";\n    }\n    break;\n  }\n  case 'send_message': {\n    responseText = piResponse.success\n      ? `Done, I've passed that along to ${intentData.state.sessionContext.sessionName || 'the session'}.`\n      : `Hmm, something went wrong sending that message. ${piResponse.error || ''}`;\n    break;\n  }\n  case 'stop_session': {\n    responseText = piResponse.success\n      ? `Done, I've interrupted ${intentData.state.sessionContext.sessionName || 'the session'}. It's paused now.`\n      : `I couldn't stop that session. ${piResponse.error || ''}`;\n    break;\n  }\n  case 'kill_session': {\n    responseText = piResponse.success\n      ? `Got it, ${intentData.state.sessionContext.sessionName || 'the session'} is shut down.`\n      : `I couldn't kill that session. ${piResponse.error || ''}`;\n    updatedSessionContext = {};\n    break;\n  }\n  case 'resume_session': {\n    responseText = piResponse.success\n      ? `${intentData.state.sessionContext.sessionName || 'The session'} is back up and running.`\n      : `I couldn't resume that session. ${piResponse.error || ''}`;\n    break;\n  }\n  case 'get_errors': {\n    const items = piResponse.items || [];\n    const unresolved = items.filter(i => !i.resolvedAt);\n    if (unresolved.length === 0) {\n      responseText = \"No errors or pending items right now. Everything looks good!\";\n    } else {\n      const summaries = unresolved.slice(0, 3).map(i => {\n        if (i.type === 'error') return `Error on ${i.sessionName}: ${i.content.slice(0, 80)}`;\n        if (i.type === 'question') return `Question on ${i.sessionName}: ${i.content.slice(0, 80)}`;\n        return `${i.type} on ${i.sessionName}: ${i.content.slice(0, 80)}`;\n      }).join('. ');\n      responseText = `You've got ${unresolved.length} item${unresolved.length > 1 ? 's' : ''} needing attention. ${summaries}.`;\n    }\n    break;\n  }\n  default:\n    responseText = \"Sorry, I didn't quite catch that. Could you say it again?\";\n}\n\n// Update state\nconst updatedState = {\n  ...intentData.state,\n  lastIntent: intent,\n  sessionContext: updatedSessionContext,\n  consecutiveTimeouts: 0\n};\nupdatedState.history.push({ role: 'assistant', content: responseText });\n\nreturn {\n  json: {\n    responseText,\n    callControlId: intentData.callControlId,\n    state: updatedState,\n    clientState: Buffer.from(JSON.stringify(updatedState)).toString('base64'),\n    intent\n  }\n};"
      },
      "id": "code-build-response",
      "name": "Build Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2400, 640]

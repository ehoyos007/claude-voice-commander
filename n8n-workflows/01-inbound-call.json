      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2100, 800],
      "credentials": { "httpHeaderAuth": { "id": "PI_SERVICE_CREDENTIAL_ID", "name": "Pi Service API" } }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Telnyx Voice Webhook').item.json._piServiceUrl || 'http://localhost:3000' }}/sessions/{{ $('Parse Intent').item.json.state.sessionContext.sessionId || 'unknown' }}/kill",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": { "response": { "response": { "neverError": true } } }
      },
      "id": "pi-kill-session",
      "name": "Pi: Kill Session",
      "type": "n8n-nodes-base.httpRequest",

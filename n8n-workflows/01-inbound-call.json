      "typeVersion": 4.2,
      "position": [2100, 650],
      "credentials": { "httpHeaderAuth": { "id": "PI_SERVICE_CREDENTIAL_ID", "name": "Pi Service API" } }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Telnyx Voice Webhook').item.json._piServiceUrl || 'http://localhost:3000' }}/sessions/{{ $('Parse Intent').item.json.state.sessionContext.sessionId || 'unknown' }}/stop",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": { "response": { "response": { "neverError": true } } }
      },
      "id": "pi-stop-session",

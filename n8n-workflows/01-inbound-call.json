    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Telnyx Voice Webhook').item.json._piServiceUrl || 'http://localhost:3000' }}/attention",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "pi-check-attention",
      "name": "Pi: Check Attention Queue",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [700, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "PI_SERVICE_CREDENTIAL_ID",
          "name": "Pi Service API"
        }
      },
      "notes": "Check pending attention items for greeting. Header: X-API-Key"
    },
    {
      "parameters": {
        "jsCode": "// Build greeting text based on pending attention items\nconst attentionData = $input.first().json;\nconst pendingCount = (attentionData.items || []).filter(i => !i.resolvedAt).length;\n\nlet greeting;\nif (pendingCount > 0) {\n  greeting = `Hey! I've got ${pendingCount} thing${pendingCount > 1 ? 's' : ''} waiting for you. Want to handle those first, or start something new?`;\n} else {\n  greeting = \"Hey! What would you like to work on?\";\n}\n\n// Get call_control_id from the original webhook\nconst webhookData = $('Telnyx Voice Webhook').first().json;\nconst callControlId = webhookData.data.payload.call_control_id;\n\n// Build initial state\nconst state = {\n  history: [],\n  lastIntent: null,\n  sessionContext: {},\n  turnCount: 0,\n  pendingAttentionCount: pendingCount\n};\n\nreturn {\n  json: {\n    greeting,\n    callControlId,\n    clientState: Buffer.from(JSON.stringify(state)).toString('base64'),\n    pendingCount\n  }\n};"
      },
      "id": "code-build-greeting",
      "name": "Build Greeting",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [920, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.elevenlabs.io/v1/text-to-speech/3sfGn775ryaDXhFWHwBg",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"text\": {{ JSON.stringify($json.greeting) }},\n  \"model_id\": \"eleven_turbo_v2\",\n  \"voice_settings\": {\n    \"stability\": 0.5,\n    \"similarity_boost\": 0.75\n  }\n}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "audioData"
            }
          }
        }
      },
      "id": "elevenlabs-greeting",

    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telnyx.com/v2/calls/{{ $json.data.payload.call_control_id }}/actions/gather",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"type\": \"speech\",\n  \"language\": \"en-US\",\n  \"speech_model\": \"default\",\n  \"end_silence_timeout_millis\": 1500,\n  \"timeout_millis\": 15000,\n  \"client_state\": \"{{ $json.data.payload.client_state }}\"\n}",
        "options": {}
      },
      "id": "telnyx-gather-after-playback",
      "name": "Telnyx: Gather Speech",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [700, 500],
      "credentials": {
        "httpHeaderAuth": {
          "id": "TELNYX_CREDENTIAL_ID",
          "name": "Telnyx API"
        }
      },
      "notes": "Start listening for user speech after audio playback finishes"
    },

    {
      "parameters": {
        "jsCode": "// Extract state and transcript from gather.ended event\nconst webhookData = $('Telnyx Voice Webhook').first().json;\nconst payload = webhookData.data.payload;\n\n// Decode client_state\nlet state;\ntry {\n  state = JSON.parse(Buffer.from(payload.client_state || '', 'base64').toString('utf-8'));\n} catch {\n  state = { history: [], lastIntent: null, sessionContext: {}, turnCount: 0 };\n}\n\n// Extract speech transcript\nconst transcript = payload.speech?.transcript || '';\nconst speechConfidence = payload.speech?.confidence || 0;\n\n// Check for timeout (no speech detected)\nconst timedOut = !transcript || transcript.trim() === '';\n\n// Add user turn to history\nif (!timedOut) {\n  state.history.push({ role: 'user', content: transcript });\n}\n\n// Keep last 10 turns to avoid state bloat\nif (state.history.length > 10) {\n  state.history = state.history.slice(-10);\n}\n\nstate.turnCount++;\n\nreturn {\n  json: {\n    callControlId: payload.call_control_id,\n    transcript,\n    speechConfidence,\n    timedOut,\n    state,\n    turnCount: state.turnCount\n  }\n};"
      },
      "id": "code-extract-state",
      "name": "Extract State & Transcript",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [700, 700]
    },
    {
      "parameters": {
        "rules": {
          "rules": [
            {
              "outputKey": "has_speech",
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{ $json.timedOut }}",
                    "rightValue": false,
                    "operator": { "type": "boolean", "operation": "equals" }
                  }
                ]
              }
            },
            {
              "outputKey": "timed_out",
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{ $json.timedOut }}",
                    "rightValue": true,
                    "operator": { "type": "boolean", "operation": "equals" }
                  }
                ]
              }
            }
          ]
        },
        "options": {}
      },
      "id": "switch-speech-check",
      "name": "Has Speech?",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [920, 700]
    },

    {
      "parameters": {
        "jsCode": "// Handle timeout — if 2+ timeouts in a row, hang up\nconst state = $json.state;\nconst timeoutCount = (state.consecutiveTimeouts || 0) + 1;\nstate.consecutiveTimeouts = timeoutCount;\n\nlet text;\nif (timeoutCount >= 2) {\n  text = \"I'll let you go for now. Call back when you're ready!\";\n} else {\n  text = \"Still there? I didn't hear anything.\";\n}\n\nreturn {\n  json: {\n    callControlId: $json.callControlId,\n    text,\n    shouldHangup: timeoutCount >= 2,\n    state,\n    clientState: Buffer.from(JSON.stringify(state)).toString('base64')\n  }\n};"
      },
      "id": "code-handle-timeout",
      "name": "Handle Timeout",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1140, 900]
    },

    {
      "parameters": {
        "jsCode": "// Build Claude intent classification prompt\nconst { transcript, state } = $json;\n\nconst historyText = state.history\n  .map(h => `${h.role === 'user' ? 'User' : 'Assistant'}: ${h.content}`)\n  .join('\\n');\n\nconst systemPrompt = `You are an intent classifier for a voice assistant that manages Claude Code sessions on a Raspberry Pi.\n\nClassify the user's speech into ONE of these intents:\n- create_session: User wants to start a new coding project/session\n- list_sessions: User wants to see what sessions are running\n- check_status: User wants status of a specific session\n- send_message: User wants to send a message/instruction to a running session\n- stop_session: User wants to pause/interrupt a session (Ctrl+C)\n- kill_session: User wants to terminate/shut down a session completely\n- resume_session: User wants to resume a preserved/stopped session\n- get_errors: User wants to check for errors or attention items\n- schedule_callback: User wants to be called back later\n- end_call: User wants to end the phone call\n- unknown: Cannot determine intent\n\nExtract these fields if present:\n- sessionName: Which project/session name is referenced (null if not mentioned)\n- message: The actual content/instruction to send to Claude (null if not applicable)\n- callbackTime: When to call back (null if not applicable)\n\nRespond with ONLY valid JSON, no markdown.`;\n\nconst userMessage = historyText\n  ? `Conversation so far:\\n${historyText}\\n\\nUser just said: \"${transcript}\"\\n\\nClassify the intent and extract fields as JSON.`\n  : `User said: \"${transcript}\"\\n\\nClassify the intent and extract fields as JSON.`;\n\nreturn {\n  json: {\n    systemPrompt,\n    userMessage,\n    callControlId: $json.callControlId,\n    transcript,\n    state\n  }\n};"
      },
      "id": "code-build-intent-prompt",
      "name": "Build Intent Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1140, 640]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-3-5-haiku-latest\",\n  \"max_tokens\": 300,\n  \"system\": {{ JSON.stringify($json.systemPrompt) }},\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": {{ JSON.stringify($json.userMessage) }}\n    }\n  ]\n}",
        "options": {}
      },
      "id": "claude-classify-intent",
      "name": "Claude: Classify Intent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1360, 640],
      "credentials": {
        "httpHeaderAuth": {
          "id": "ANTHROPIC_CREDENTIAL_ID",
          "name": "Anthropic API"
        }
      },
      "notes": "Header: x-api-key = sk-ant-... (use httpHeaderAuth with name 'x-api-key')"
    },
    {
      "parameters": {
        "jsCode": "// Parse Claude's intent classification response\nconst claudeResponse = $input.first().json;\nconst prevData = $('Build Intent Prompt').first().json;\n\nlet intentData;\ntry {\n  const text = claudeResponse.content[0].text;\n  // Try to parse JSON from Claude's response\n  const jsonMatch = text.match(/\\{[\\s\\S]*\\}/);\n  intentData = JSON.parse(jsonMatch ? jsonMatch[0] : text);\n} catch (e) {\n  intentData = {\n    intent: 'unknown',\n    sessionName: null,\n    message: null,\n    confidence: 0\n  };\n}\n\nreturn {\n  json: {\n    intent: intentData.intent || 'unknown',\n    sessionName: intentData.sessionName || null,\n    message: intentData.message || prevData.transcript,\n    callbackTime: intentData.callbackTime || null,\n    confidence: intentData.confidence || 0,\n    callControlId: prevData.callControlId,\n    transcript: prevData.transcript,\n    state: prevData.state\n  }\n};"
      },
      "id": "code-parse-intent",
      "name": "Parse Intent",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1580, 640]
    },
    {
      "parameters": {
        "rules": {
          "rules": [
            {
              "outputKey": "create_session",
              "conditions": { "conditions": [{ "leftValue": "={{ $json.intent }}", "rightValue": "create_session", "operator": { "type": "string", "operation": "equals" } }] }
            },
            {
              "outputKey": "list_sessions",
              "conditions": { "conditions": [{ "leftValue": "={{ $json.intent }}", "rightValue": "list_sessions", "operator": { "type": "string", "operation": "equals" } }] }
            },
            {
              "outputKey": "check_status",
              "conditions": { "conditions": [{ "leftValue": "={{ $json.intent }}", "rightValue": "check_status", "operator": { "type": "string", "operation": "equals" } }] }
            },
            {
              "outputKey": "send_message",
              "conditions": { "conditions": [{ "leftValue": "={{ $json.intent }}", "rightValue": "send_message", "operator": { "type": "string", "operation": "equals" } }] }
            },
            {
              "outputKey": "stop_session",
              "conditions": { "conditions": [{ "leftValue": "={{ $json.intent }}", "rightValue": "stop_session", "operator": { "type": "string", "operation": "equals" } }] }
            },
            {
              "outputKey": "kill_session",
              "conditions": { "conditions": [{ "leftValue": "={{ $json.intent }}", "rightValue": "kill_session", "operator": { "type": "string", "operation": "equals" } }] }
            },
            {
              "outputKey": "resume_session",
              "conditions": { "conditions": [{ "leftValue": "={{ $json.intent }}", "rightValue": "resume_session", "operator": { "type": "string", "operation": "equals" } }] }
            },
            {
              "outputKey": "get_errors",
              "conditions": { "conditions": [{ "leftValue": "={{ $json.intent }}", "rightValue": "get_errors", "operator": { "type": "string", "operation": "equals" } }] }
            },
            {
              "outputKey": "end_call",
              "conditions": { "conditions": [{ "leftValue": "={{ $json.intent }}", "rightValue": "end_call", "operator": { "type": "string", "operation": "equals" } }] }
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra"
        }
      },
      "id": "switch-intent",
      "name": "Route Intent",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [1800, 640]
    },

    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Telnyx Voice Webhook').item.json._piServiceUrl || 'http://localhost:3000' }}/sessions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",

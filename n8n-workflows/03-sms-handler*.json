    {
      "parameters": {
        "jsCode": "// Parse Claude's response\nconst claudeResponse = $input.first().json;\nconst prevData = $('Build Claude Prompt').first().json;\nconst smsData = $('Extract SMS Data').first().json;\n\nlet parsed;\ntry {\n  const text = claudeResponse.content[0].text;\n  let jsonStr = text;\n  const jsonMatch = text.match(/```(?:json)?\\s*([\\s\\S]*?)```/) || text.match(/\\{[\\s\\S]*\\}/);\n  if (jsonMatch) {\n    jsonStr = jsonMatch[1] || jsonMatch[0];\n  }\n  parsed = JSON.parse(jsonStr.trim());\n} catch (e) {\n  // If JSON parsing fails, use the raw text as response\n  parsed = {\n    response: claudeResponse.content[0].text.slice(0, 160),\n    intent: 'general_chat',\n    sessionName: null,\n    message: null,\n    needsPiAction: false\n  };\n}\n\n// Update state with assistant response\nconst state = { ...prevData.state };\nstate.history.push({ role: 'assistant', content: parsed.response });\nstate.lastIntent = parsed.intent;\n\nreturn {\n  json: {\n    responseText: parsed.response,\n    intent: parsed.intent || 'unknown',\n    sessionName: parsed.sessionName,\n    message: parsed.message,\n    needsPiAction: parsed.needsPiAction || false,\n    conversationId: prevData.conversationId,\n    fromNumber: smsData.fromNumber,\n    toNumber: smsData.toNumber,\n    state\n  }\n};"
      },

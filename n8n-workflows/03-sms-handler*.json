      "parameters": {
        "jsCode": "// Handle Pi-initiated SMS (notifications, alerts)\nconst body = $input.first().json.body || $input.first().json;\n\nconst toNumber = body.phoneNumber || body.to;\nconst messageText = body.message || body.text;\nconst fromNumber = body.from || process.env.TELNYX_PHONE_NUMBER || '+18005551234';\nconst conversationId = `sms-${toNumber.replace(/\\D/g, '')}`;\n\nreturn {\n  json: {\n    toNumber,\n    fromNumber,\n    messageText: messageText.slice(0, 160),\n    conversationId,\n    isOutbound: true\n  }\n};"
      },
      "name": "Prepare Pi SMS",

    {
      "parameters": {
        "jsCode": "// Extract SMS details and load/create conversation state\nconst webhookData = $input.first().json;\nconst payload = webhookData.data.payload;\n\nconst fromNumber = payload.from?.phone_number || payload.from;\nconst toNumber = payload.to?.[0]?.phone_number || payload.to;\nconst messageText = payload.text || '';\nconst messageId = payload.id;\n\n// Generate a conversation ID based on phone number\nconst conversationId = `sms-${fromNumber.replace(/\\D/g, '')}`;\n\nreturn {\n  json: {\n    conversationId,\n    fromNumber,\n    toNumber,\n    messageText,\n    messageId,\n    receivedAt: new Date().toISOString()\n  }\n};"
      },
      "name": "Extract SMS Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [0, 240],
      "id": "sms-extract-001"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://msqhstkdltiabqntjyqh.supabase.co/rest/v1/sms_conversations?conversation_id=eq.{{ $json.conversationId }}&limit=1",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "name": "Supabase: Get Conversation",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [224, 240],
      "id": "sms-get-convo-001",
      "credentials": {
        "httpHeaderAuth": {
          "id": "SNE3zyRFD9QkBiqF",
          "name": "Supabase Service Key Claude-Pi"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Merge existing conversation state or create new\nconst smsData = $('Extract SMS Data').first().json;\nconst existingConvo = $input.first().json;\n\nlet state;\nif (Array.isArray(existingConvo) && existingConvo.length > 0) {\n  // Existing conversation\n  state = existingConvo[0].state || {};\n  state.history = state.history || [];\n} else if (existingConvo && existingConvo.conversation_id) {\n  state = existingConvo.state || {};\n  state.history = state.history || [];\n} else {\n  // New conversation\n  state = {\n    history: [],\n    lastIntent: null,\n    sessionContext: {},\n    turnCount: 0\n  };\n}\n\n// Add user message to history\nstate.history.push({ role: 'user', content: smsData.messageText });\n\n// Keep history manageable\nif (state.history.length > 20) {\n  state.history = state.history.slice(-20);\n}\n\nstate.turnCount = (state.turnCount || 0) + 1;\n\nreturn {\n  json: {\n    ...smsData,\n    state,\n    isNewConversation: !existingConvo || (Array.isArray(existingConvo) && existingConvo.length === 0)\n  }\n};"
      },
      "name": "Merge Conversation State",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [448, 240],
      "id": "sms-merge-state-001"
    },
    {
      "parameters": {
        "jsCode": "// Build Claude prompt for SMS intent classification and response\nconst { messageText, state, conversationId } = $json;\n\nconst historyText = state.history\n  .slice(-10)\n  .map(h => `${h.role === 'user' ? 'User' : 'Assistant'}: ${h.content}`)\n  .join('\\n');\n\nconst systemPrompt = `You are Claude, a helpful AI assistant managing Claude Code sessions on a Raspberry Pi via SMS.\n\nYou can help the user with:\n- Creating new coding sessions\n- Checking session status\n- Sending messages/instructions to running sessions\n- Stopping, killing, or resuming sessions\n- Checking for errors or attention items\n- General questions about their projects\n\nRespond conversationally but keep responses under 160 characters when possible (SMS limit). Be concise but helpful.\n\nIf the user's request is unclear, ask a brief clarifying question.\n\nAlso classify the intent as one of:\n- create_session, list_sessions, check_status, send_message, stop_session, kill_session, resume_session, get_errors, general_chat, unknown\n\nExtract sessionName and message if present.\n\nRespond with JSON:\n{\n  \"response\": \"Your SMS response here\",\n  \"intent\": \"...\",\n  \"sessionName\": null,\n  \"message\": null,\n  \"needsPiAction\": true/false\n}`;\n\nconst userMessage = historyText\n  ? `Conversation:\\n${historyText}\\n\\nRespond to the latest message.`\n  : `User said: \"${messageText}\"\\n\\nRespond.`;\n\nreturn {\n  json: {\n    systemPrompt,\n    userMessage,\n    conversationId,\n    messageText,\n    state\n  }\n};"
      },
      "name": "Build Claude Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [672, 240],
      "id": "sms-build-prompt-001"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-3-5-haiku-latest\",\n  \"max_tokens\": 300,\n  \"system\": {{ JSON.stringify($json.systemPrompt) }},\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": {{ JSON.stringify($json.userMessage) }}\n    }\n  ]\n}",
        "options": {}
      },
      "name": "Claude: Generate Response",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [896, 240],
      "id": "sms-claude-001",
      "credentials": {

    {
      "parameters": {
        "jsCode": "// Build final SMS response incorporating Pi action results\nconst parseData = $('Parse Response').first().json;\nconst piResponse = $input.first().json;\nconst intent = parseData.intent;\n\nlet finalResponse = parseData.responseText;\n\n// Enhance response based on Pi results\nif (piResponse) {\n  switch (intent) {\n    case 'create_session':\n      if (piResponse.session) {\n        finalResponse = `Created ${piResponse.session.name}! ${parseData.message ? 'Working on it now.' : 'What should I do?'}`;\n      }\n      break;\n    case 'list_sessions':\n      const sessions = piResponse.sessions || piResponse || [];\n      if (Array.isArray(sessions) && sessions.length > 0) {\n        finalResponse = `Sessions: ${sessions.map(s => `${s.name} (${s.status})`).join(', ')}`;\n      } else {\n        finalResponse = 'No sessions running. Want to start one?';\n      }\n      break;\n    case 'check_status':\n      if (piResponse.session || piResponse.status) {\n        const s = piResponse.session || piResponse;\n        finalResponse = `${s.name || 'Session'}: ${s.status}${s.lastOutputPreview ? ' - ' + s.lastOutputPreview.slice(0, 50) : ''}`;\n      }\n      break;\n    case 'get_errors':\n      const items = piResponse.items || [];\n      const pending = items.filter(i => !i.resolvedAt);\n      finalResponse = pending.length > 0\n        ? `${pending.length} pending: ${pending[0].preview || pending[0].content?.slice(0, 80) || 'View details?'}`\n        : 'All clear! No errors.';\n      break;\n  }\n}\n\n// Truncate to SMS limit if needed\nif (finalResponse.length > 160) {\n  finalResponse = finalResponse.slice(0, 157) + '...';\n}\n\nreturn {\n  json: {\n    responseText: finalResponse,\n    conversationId: parseData.conversationId,\n    fromNumber: parseData.fromNumber,\n    toNumber: parseData.toNumber,\n    state: parseData.state,\n    intent\n  }\n};"
      },

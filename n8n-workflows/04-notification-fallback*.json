    {
      "parameters": {
        "jsCode": "// Check delivery result and determine if fallback needed\nconst parseData = $('Parse Notification').first().json;\nconst deliveryResult = $input.first().json;\n\nlet success = false;\nlet errorMessage = null;\n\n// Check based on channel type\nconst channel = parseData.currentChannel;\n\nswitch (channel) {\n  case 'call':\n    success = deliveryResult.success === true || deliveryResult.data?.call_control_id;\n    errorMessage = deliveryResult.error || deliveryResult.message;\n    break;\n  case 'sms':\n    success = deliveryResult.data?.id || deliveryResult.id;\n    errorMessage = deliveryResult.errors?.[0]?.detail;\n    break;\n  case 'email':\n    // SendGrid returns empty body on success (202)\n    success = !deliveryResult.errors;\n    errorMessage = deliveryResult.errors?.[0]?.message;\n    break;\n}\n\nconst attempt = {\n  channel,\n  success,\n  timestamp: new Date().toISOString(),\n  error: errorMessage\n};\n\nconst notification = { ...parseData.notification };\nnotification.attempts.push(attempt);\n\nconst nextChannelIndex = parseData.currentChannelIndex + 1;\nconst hasMoreChannels = nextChannelIndex < parseData.channelOrder.length;\nconst needsFallback = !success && hasMoreChannels;\n\nreturn {\n  json: {\n    notification,\n    channelOrder: parseData.channelOrder,\n    currentChannelIndex: nextChannelIndex,\n    currentChannel: needsFallback ? parseData.channelOrder[nextChannelIndex] : null,\n    lastAttempt: attempt,\n    success,\n    needsFallback,\n    finalStatus: success ? 'delivered' : (hasMoreChannels ? 'retrying' : 'failed')\n  }\n};"
      },
      "name": "Check Delivery Result",

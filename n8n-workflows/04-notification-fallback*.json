    {
      "parameters": {
        "jsCode": "// Parse notification request and determine priority/channels\nconst body = $input.first().json.body || $input.first().json;\n\nconst notification = {\n  id: body.id || `notif-${Date.now()}`,\n  type: body.type || 'info',  // error, question, alert, info\n  urgency: body.urgency || 'normal',  // critical, high, normal, low\n  title: body.title || 'Notification',\n  message: body.message || '',\n  sessionName: body.sessionName || null,\n  attentionItems: body.attentionItems || [],\n  phoneNumber: body.phoneNumber || '+13055551234',\n  email: body.email || null,\n  preferredChannel: body.preferredChannel || 'auto',  // call, sms, email, push, auto\n  createdAt: new Date().toISOString(),\n  attempts: []\n};\n\n// Determine channel order based on urgency\nlet channelOrder;\nswitch (notification.urgency) {\n  case 'critical':\n    channelOrder = ['call', 'sms', 'email'];\n    break;\n  case 'high':\n    channelOrder = ['call', 'sms', 'email'];\n    break;\n  case 'normal':\n    channelOrder = ['sms', 'email'];\n    break;\n  case 'low':\n    channelOrder = ['email', 'sms'];\n    break;\n  default:\n    channelOrder = ['sms', 'email'];\n}\n\n// Override if preferred channel specified\nif (notification.preferredChannel !== 'auto') {\n  channelOrder = [notification.preferredChannel, ...channelOrder.filter(c => c !== notification.preferredChannel)];\n}\n\nreturn {\n  json: {\n    notification,\n    channelOrder,\n    currentChannelIndex: 0,\n    currentChannel: channelOrder[0]\n  }\n};"
      },
      "name": "Parse Notification",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-480, 304],

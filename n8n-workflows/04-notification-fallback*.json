        "jsonBody": "={\n  \"personalizations\": [\n    {\n      \"to\": [\n        {\n          \"email\": {{ JSON.stringify($json.notification.email || 'enzo@firsthealthenrollment.com') }}\n        }\n      ],\n      \"subject\": {{ JSON.stringify(($json.notification.urgency === 'critical' ? '[CRITICAL] ' : $json.notification.urgency === 'high' ? '[HIGH] ' : '') + 'Claude Pi: ' + $json.notification.title) }}\n    }\n  ],\n  \"from\": {\n    \"email\": \"claude-pi@firsthealthenrollment.com\",\n    \"name\": \"Claude Pi\"\n  },\n  \"content\": [\n    {\n      \"type\": \"text/html\",\n      \"value\": {{ JSON.stringify('<h2>' + $json.notification.title + '</h2><p>' + $json.notification.message + '</p>' + ($json.notification.sessionName ? '<p><strong>Session:</strong> ' + $json.notification.sessionName + '</p>' : '') + '<hr><p style=\"color: #666; font-size: 12px;\">Urgency: ' + $json.notification.urgency + ' | Type: ' + $json.notification.type + '</p>') }}\n    }\n  ]\n}",

      "parameters": {
        "jsCode": "// Check fallback delivery result\nconst checkData = $('Check Delivery Result').first().json;\nconst deliveryResult = $input.first().json;\n\nlet success = false;\nconst channel = checkData.currentChannel;\n\nswitch (channel) {\n  case 'call':\n    success = deliveryResult.success === true || deliveryResult.data?.call_control_id;\n    break;\n  case 'sms':\n    success = deliveryResult.data?.id || deliveryResult.id;\n    break;\n  case 'email':\n    success = !deliveryResult.errors;\n    break;\n}\n\nconst attempt = {\n  channel,\n  success,\n  timestamp: new Date().toISOString(),\n  isFallback: true\n};\n\nconst notification = { ...checkData.notification };\nnotification.attempts.push(attempt);\n\nreturn {\n  json: {\n    notification,\n    lastAttempt: attempt,\n    success,\n    finalStatus: success ? 'delivered_fallback' : 'failed'\n  }\n};"
